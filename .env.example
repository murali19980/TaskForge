OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_MAX_CONCURRENT=2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash:free
OPENROUTER_MODELS=nvidia/nemotron-3-ultra:free,google/gemma-4-31b:free,cohere/north-mini-code:free,openai/gpt-oss-120b:free,nvidia/nemotron-3-super:free,openrouter/free
OPENROUTER_MAX_CONCURRENT=10
# CORS allowed origins (leave empty to disable CORS completely)
CORS_ORIGINS=
# Application environment. Options: development | production
# In production mode, API_KEY is mandatory and HTTPS enforcement warnings are enabled.
ENV=development
# Secure access authentication key
# Leave empty ONLY for local development (ENV=development). REQUIRED for production.
API_KEY=
LOG_LEVEL=INFO
MAX_INPUT_LENGTH=2000
MAX_COST_PER_REQUEST=0.01
LLM_REQUEST_TIMEOUT=180
RATE_LIMIT_PER_MINUTE=5
